#!/usr/bin/env bash
# lyrics-widget-setup [--hyprland] [--key LETTER]
set -e

want_hypr=0
key="L"
while [ $# -gt 0 ]; do
    case "$1" in
        --hyprland) want_hypr=1 ;;
        --key) key="${2:?--key needs a letter}"; shift ;;
        -h|--help)
            echo "usage: lyrics-widget-setup [--hyprland] [--key LETTER]"
            echo "  --hyprland  also add autostart and a SUPER+CTRL+KEY toggle bind to your Hyprland config"
            exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done
if [[ "$key" != [abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ] ]]; then
    echo "--key must be one ASCII letter (A-Z)." >&2
    exit 2
fi
key="${key^^}"

qsdir="$HOME/.config/quickshell/lyrics"
QS="qs -p $qsdir"

mkdir -p "$HOME/.config/quickshell" "$HOME/Music/Lyrics"
[ -L "$qsdir" ] && rm "$qsdir"
mkdir -p "$qsdir"
source_qml="/usr/share/lyrics-widget/shell.qml"
target_qml="$qsdir/shell.qml"
if [ -e "$target_qml" ] && ! cmp -s "$source_qml" "$target_qml"; then
    qml_backup=$(mktemp "$target_qml.bak.XXXXXX")
    cp -- "$target_qml" "$qml_backup"
    printf 'Saved the previous widget configuration: %s\n' "$qml_backup"
fi
cp -f -- "$source_qml" "$target_qml"
echo "Installed the widget to $qsdir"

if [ "$want_hypr" = 1 ]; then
    hdir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
    if [ -f "$hdir/hyprland.lua" ]; then
        cfg="$hdir/hyprland.lua"; mode=lua
    elif [ -f "$hdir/hyprland.conf" ]; then
        cfg="$hdir/hyprland.conf"; mode=conf
    else
        echo "No Hyprland config found in $hdir, skipping --hyprland" >&2
        exit 0
    fi

    if grep -rqE "qs +-[cp] +[^\"' ]*lyrics" --include='*.lua' --include='*.conf' "$hdir" 2>/dev/null; then
        echo "Your Hyprland config already starts the lyrics widget, nothing to add"
    else
        if [ "$mode" = lua ]; then
            clash=$(grep -rniE "SUPER *\+ *CTRL *\+ *$key\"" --include='*.lua' "$hdir" 2>/dev/null || true)
        else
            clash=$(grep -rniE "^ *bind[a-z]* *= *SUPER[ ,]*CTRL *, *$key *," --include='*.conf' "$hdir" 2>/dev/null || true)
        fi
        if [ -n "$clash" ]; then
            echo "SUPER+CTRL+$key is already used, nothing was changed:" >&2
            echo "$clash" | head -3 >&2
            echo "Re-run with another key, e.g. lyrics-widget-setup --hyprland --key Y" >&2
            exit 1
        fi
        cfg_backup=$(mktemp "$cfg.lyrics-widget.bak.XXXXXX")
        cp -- "$cfg" "$cfg_backup"
        if [ "$mode" = lua ]; then
            {
                echo ""
                echo "-- lyrics-widget (added by lyrics-widget-setup)"
                echo 'hl.on("hyprland.start", function ()'
                echo "    hl.exec_cmd(\"$QS\")"
                echo 'end)'
                echo "hl.bind(\"SUPER + CTRL + $key\", hl.dsp.exec_cmd(\"sh -c '$QS ipc call lyrics toggle || $QS'\"), { description = \"Toggle lyrics\" })"
            } >> "$cfg"
        else
            {
                echo ""
                echo "# lyrics-widget (added by lyrics-widget-setup)"
                echo "exec-once = $QS"
                echo "bind = SUPER CTRL, $key, exec, sh -c '$QS ipc call lyrics toggle || $QS'"
            } >> "$cfg"
        fi
        echo "Added autostart and SUPER+CTRL+$key to $cfg (backup: $cfg_backup)"
        echo "Log out and back in to load it."
    fi
fi

echo "Done. Start it now with: setsid -f $QS"
