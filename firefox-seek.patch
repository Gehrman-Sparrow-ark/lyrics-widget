+def timeline_sample(tl, playing):
+    pos = tl.position.total_seconds()
+    length = max(0.0, (tl.end_time - tl.start_time).total_seconds())
+    # Firefox clears both fields when it has no media position state.
+    # A real seek to zero with a known duration is still valid.
+    if pos == 0.0 and length == 0.0:
+        return UNKNOWN_POSITION, 0.0
+    if playing:
+        last = tl.last_updated_time
+        if last.tzinfo is None:
+            last = last.replace(tzinfo=timezone.utc)
+        dt = (datetime.now(timezone.utc) - last).total_seconds()
+        if 0 < dt < 86400:
+            pos += dt
+    if length > 0:
+        pos = min(pos, length)
+    return max(0.0, pos), length
 
 
